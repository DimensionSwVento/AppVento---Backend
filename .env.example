# ── Datos ────────────────────────────────────────────────────────────────────
# Ruta al parquet maestro (por defecto apunta al del frontend en el repo).
PARQUET_PATH=./data/master_variables.h3.parquet

# ── Autenticación (Keycloak) ─────────────────────────────────────────────────
# No hay login/registro aquí: Keycloak los maneja; el backend solo verifica JWT.
# La autenticación es OBLIGATORIA (no configurable): todos los endpoints de datos
# exigen identidad verificada (JWT de Keycloak o header interno del BFF).
KEYCLOAK_ISSUER=http://localhost:8080/realms/vento
# JWKS se deriva del issuer; sobreescribir solo si difiere:
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/vento/protocol/openid-connect/certs
JWT_ALGORITHMS=RS256

# Secreto compartido con el frontend (BFF Next → FastAPI) para el histórico.
# Debe coincidir con INTERNAL_API_SECRET del Vento. Genera uno largo y aleatorio.
INTERNAL_API_SECRET=cambiar-por-un-secreto-largo-aleatorio

# ── Base de datos (Postgres) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://vento:vento@localhost:5432/vento

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Histórico ────────────────────────────────────────────────────────────────
MAX_HISTORIAL_PER_USER=50
